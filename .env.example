# Local dev only — Expo's cloud build servers (eas build) never read this
# file. For production/TestFlight builds, the equivalent values need to be
# set as EAS environment variables instead: `eas env:create --environment
# production --name <NAME> --value <VALUE>`.
#
# Only vars prefixed EXPO_PUBLIC_ are exposed to the app at runtime — Expo
# strips anything else out of the client bundle.

# Optional — both already default to the real production backend
# (see src/api/client.ts, src/utils/constants.ts) if left unset.
EXPO_PUBLIC_API_URL=https://sprintfastest-api.onrender.com/api/v1
EXPO_PUBLIC_WEBSOCKET_URL=wss://sprintfastest-api.onrender.com/ws

# Required for RevenueCat purchases/restore to work — no fallback if unset,
# see src/services/purchases.ts. Get these from the RevenueCat dashboard →
# Project Settings → API Keys.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
